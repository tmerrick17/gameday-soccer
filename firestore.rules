rules_version = '2';

// GameDay Soccer — Slice 8 security rules.
// Two-tier access model: Head Coach (full control) and Coach (edit, no membership management).
// Invite-only: no public discovery of any team or player data.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function memberRef(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid);
    }

    function isMember(teamId) {
      return isSignedIn() && exists(memberRef(teamId));
    }

    function isHeadCoach(teamId) {
      return isMember(teamId) && get(memberRef(teamId)).data.role == "head-coach";
    }

    function validInviteCode(code, teamId) {
      return exists(/databases/$(database)/documents/inviteCodes/$(code))
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.teamId == teamId;
    }

    // ── Teams ─────────────────────────────────────────────────────────────────

    match /teams/{teamId} {
      allow read: if isMember(teamId);

      // Creating a team: auth user must be the designated head coach.
      allow create: if isSignedIn()
        && request.resource.data.headCoachId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'headCoachId', 'inviteCode', 'createdAt']);

      // Updating: members may edit team data; only head coach may rotate inviteCode.
      allow update: if isMember(teamId)
        && (isHeadCoach(teamId)
            || !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['headCoachId', 'inviteCode']));

      // Deleting a team: head coach only.
      allow delete: if isHeadCoach(teamId);
    }

    // ── Members sub-collection ────────────────────────────────────────────────

    match /teams/{teamId}/members/{userId} {
      // Any team member may read the membership list.
      allow read: if isMember(teamId);

      allow create: if isSignedIn() && request.auth.uid == userId && (
        // Head coach bootstrapping their own first membership after team creation.
        (request.resource.data.role == "head-coach"
          && get(/databases/$(database)/documents/teams/$(teamId)).data.headCoachId == request.auth.uid)
        ||
        // Coach joining with a valid invite code (stored in the membership doc).
        (request.resource.data.role == "coach"
          && request.resource.data.inviteCode is string
          && validInviteCode(request.resource.data.inviteCode, teamId))
      );

      // Head coach may update/remove other members (not themselves).
      allow update: if isHeadCoach(teamId) && userId != request.auth.uid;
      allow delete: if isHeadCoach(teamId) && userId != request.auth.uid;
    }

    // ── Invite codes ──────────────────────────────────────────────────────────
    // Readable by any authenticated user so a prospective coach can preview
    // the team name before joining.

    match /inviteCodes/{code} {
      allow read: if isSignedIn();

      // Only the team's head coach may create or rotate an invite code.
      allow create: if isSignedIn()
        && isHeadCoach(request.resource.data.teamId)
        && request.resource.data.code == code;

      allow update: if isSignedIn() && isHeadCoach(resource.data.teamId);
      allow delete: if isSignedIn() && isHeadCoach(resource.data.teamId);
    }

    // ── Team config (preferences, etc.) ──────────────────────────────────────
    // Any team member can read and write config documents.

    match /teams/{teamId}/config/{configDoc} {
      allow read, write: if isMember(teamId);
    }

    // ── Roster ────────────────────────────────────────────────────────────────
    // Any team member can read and write roster data.

    match /teams/{teamId}/roster/{playerId} {
      allow read, write: if isMember(teamId);
    }

    // ── Games ─────────────────────────────────────────────────────────────────
    // Any team member can read and write game session documents.

    match /teams/{teamId}/games/{gameId} {
      allow read, write: if isMember(teamId);
    }

    // ── Formations ────────────────────────────────────────────────────────────
    // Any team member can read and write formations.

    match /teams/{teamId}/formations/{formationId} {
      allow read, write: if isMember(teamId);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
